---
// src/components/Search.astro
// Component untuk client-side search menggunakan pagefind
---

<div id="search-container" class="mb-12">
  <div class="relative max-w-2xl mx-auto">
    <input
      type="text"
      id="search-input"
      placeholder="Cari artikel..."
      class="w-full px-6 py-4 pl-14 rounded-full border border-gray-200 focus:border-gold-500 focus:ring-2 focus:ring-gold-500/20 outline-none transition bg-white shadow-sm"
      aria-label="Cari artikel"
    />
    <i class="fa-solid fa-search absolute left-5 top-1/2 -translate-y-1/2 text-gray-400 text-xl"></i>
  </div>
  <div id="search-results" class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6"></div>
  <div id="search-loading" class="text-center text-slate-500 py-8 hidden">
    <i class="fa-solid fa-spinner fa-spin text-2xl"></i>
    <p class="mt-2">Mencari...</p>
  </div>
</div>

<!-- Load Pagefind Script -->
<script is:inline>
  // Inisialisasi pagefind
  async function initSearch() {
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const searchLoading = document.getElementById('search-loading');

    if (!searchInput || !searchResults) return;

    // Load pagefind hanya jika dibutuhkan
    let pagefind = null;

    searchInput.addEventListener('input', async (e) => {
      const query = e.target.value.trim();
      searchResults.innerHTML = '';
      searchLoading.classList.remove('hidden');

      if (query.length < 2) {
        searchLoading.classList.add('hidden');
        return;
      }

      try {
        if (!pagefind) {
          const module = await import('/pagefind/pagefind.js');
          pagefind = module.default;
        }

        const results = await pagefind.search(query);
        searchLoading.classList.add('hidden');

        if (results.results.length === 0) {
          searchResults.innerHTML = `
            <div class="col-span-full text-center text-slate-500 py-12">
              <i class="fa-solid fa-file-magnifying-glass text-4xl mb-4 block"></i>
              <p class="text-lg">Tidak ada artikel yang ditemukan untuk "<strong>${query}</strong>"</p>
            </div>
          `;
          return;
        }

        // Render hasil
        for (const result of results.results) {
          const data = await result.data();
          const article = document.createElement('article');
          article.className =
            'p-6 rounded-xl border border-gray-100 hover:border-gold-300 hover:shadow-md transition bg-white group';
          article.innerHTML = `
            <a href="${data.url}" class="block">
              <h3 class="text-lg font-bold text-dark mb-2 group-hover:text-gold-600 transition-colors">${data.meta.title || 'Untitled'}</h3>
              <p class="text-sm text-slate-500">${data.meta.description || ''}</p>
              ${data.meta.tags ? `<div class="flex flex-wrap gap-2 mt-3">${data.meta.tags.map(tag => `<span class="text-xs px-2 py-1 bg-gold-50 text-gold-700 rounded-full">#${tag}</span>`).join('')}</div>` : ''}
            </a>
          `;
          searchResults.appendChild(article);
        }
      } catch (error) {
        console.error('Search error:', error);
        searchLoading.classList.add('hidden');
        searchResults.innerHTML = `
          <div class="col-span-full text-center text-red-500 py-8">
            <p>Gagal melakukan pencarian. Silakan coba lagi.</p>
          </div>
        `;
      }
    });
  }

  // Jalankan init setelah DOM siap
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style is:global>
  #search-results article {
    transition: all 0.2s ease;
  }
  #search-results article:hover {
    transform: translateY(-2px);
  }
</style>