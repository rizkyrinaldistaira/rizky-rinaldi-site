---
// src/components/Hero.astro
---

<section
  id="beranda"
  class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-white"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-gold-100/40 via-white to-white"
    ></div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gold-50 border border-gold-200 text-gold-700 font-medium text-sm mb-6"
        >
          <i class="fa-solid fa-check-circle" aria-hidden="true"></i>
          Layanan Profesional, Amanah, dan Terpercaya
        </div>
        <h1
          class="text-4xl lg:text-6xl font-extrabold text-dark leading-tight mb-4"
        >
          Rizky Rinaldi, S.Kom., M.Kom. <br />
          <span class="text-xl lg:text-3xl font-semibold text-slate-500 mt-2 block"
            >Dosen IT & Praktisi Pengembangan Website</span
          >
        </h1>
        <p class="text-lg lg:text-xl text-slate-600 mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Menghubungkan dunia akademis dan bisnis melalui inovasi teknologi pendidikan, riset
          kecerdasan buatan (AI), pembuatan website sekolah/kampus, serta bimbingan publikasi karya
          ilmiah bereputasi.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="#layanan"
            class="bg-dark text-white px-8 py-3.5 rounded-full font-semibold hover:bg-gold-600 transition-colors flex items-center justify-center gap-2 shadow-lg"
            aria-label="Lihat Layanan IT dan pembuatan website"
          >
            Jasa Website & Sistem IT <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
          <a
            href="#akademis"
            class="bg-white text-dark border border-gray-200 px-8 py-3.5 rounded-full font-semibold hover:border-gold-500 hover:text-gold-600 transition-colors flex items-center justify-center gap-2 shadow-sm"
            aria-label="Lihat portofolio publikasi ilmiah"
          >
            Portofolio Akademis <i class="fa-solid fa-book" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Image - langsung pakai UI-avatars -->
      <div class="order-1 lg:order-2 flex justify-center">
        <div class="relative">
          <div
            class="absolute inset-0 bg-gradient-to-tr from-gold-400 to-gold-200 rounded-[2rem] transform rotate-3 scale-105 opacity-50 blur-lg"
            aria-hidden="true"
          ></div>
          <div
            class="absolute inset-0 bg-gold-500 rounded-[2rem] transform -rotate-3 transition-transform hover:rotate-0 duration-500"
            aria-hidden="true"
          ></div>
          <img
            src="/myfoto.jpg"
            alt="Rizky Rinaldi, S.Kom., M.Kom. - Dosen STAI Raudhatul Akmal dan Penyedia Jasa Website Profesional"
            class="relative z-10 rounded-[2rem] shadow-2xl object-cover w-72 h-72 lg:w-96 lg:h-96 border-4 border-white"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>