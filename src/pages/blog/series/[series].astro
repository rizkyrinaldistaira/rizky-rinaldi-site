---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_URL } from '../../../consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const seriesNames = [...new Set(
    allPosts.filter(p => p.data.series).map(p => p.data.series!)
  )];
  return seriesNames.map(name => ({
    params: { series: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') },
    props: { seriesName: name },
  }));
}

const { seriesName } = Astro.props;
const { series: seriesSlug } = Astro.params;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(p => p.data.series === seriesName)
  .sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));

const description = posts[0]?.data.seriesDescription ?? `Seri artikel tentang ${seriesName}.`;
const icon = posts[0]?.data.seriesIcon ?? 'fa-book-open';

// JSON-LD
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: seriesName,
  description,
  provider: {
    '@type': 'Person',
    name: 'Rizky Rinaldi, S.Kom., M.Kom.',
    url: SITE_URL,
  },
  hasCourseInstance: posts.map(p => ({
    '@type': 'CourseInstance',
    name: p.data.title,
    description: p.data.description,
    url: `${SITE_URL}/blog/${p.id}`,
  })),
};
---

<BaseLayout
  title={`${seriesName} | ${SITE_TITLE}`}
  description={description}
  canonical={`${SITE_URL}/blog/series/${seriesSlug}`}
  pageType="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <!-- Hero -->
  <section class="bg-white border-b border-slate-100 pt-32 pb-12">
    <div class="max-w-4xl mx-auto px-6">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-amber-600 transition-colors mb-6 group">
        <i class="fa-solid fa-arrow-left text-xs group-hover:-translate-x-1 transition-transform"></i>
        Kembali ke Blog
      </a>
      <div class="flex items-start gap-5">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center flex-shrink-0">
          <i class={`fa-solid ${icon} text-amber-600 text-2xl`}></i>
        </div>
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-xs font-semibold uppercase tracking-widest text-amber-600 bg-amber-50 px-3 py-1 rounded-full border border-amber-100">
              Seri Pembelajaran
            </span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-800 mb-3 leading-tight">
            {seriesName}
          </h1>
          <p class="text-slate-500 text-base leading-relaxed max-w-2xl">{description}</p>
          <div class="flex items-center gap-6 mt-4 text-sm text-slate-400">
            <span class="flex items-center gap-1.5">
              <i class="fa-solid fa-list-ol text-amber-500"></i>
              {posts.length} artikel
            </span>
            <span class="flex items-center gap-1.5">
              <i class="fa-regular fa-clock text-amber-500"></i>
              Estimasi {posts.length * 10} menit belajar
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Daftar Artikel -->
  <div class="max-w-4xl mx-auto px-6 py-12">
    <div class="space-y-4">
      {posts.map((post, i) => (
        <div class="relative">
          {/* Garis koneksi vertikal */}
          {i < posts.length - 1 && (
            <div class="absolute left-6 top-full w-0.5 h-4 bg-slate-200 z-10"></div>
          )}
          <a
            href={`/blog/${post.id}`}
            class="group flex gap-5 bg-white border border-slate-200 rounded-2xl p-5 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-50 transition-all duration-200 no-underline"
          >
            {/* Nomor part */}
            <div class="flex-shrink-0 flex flex-col items-center gap-1">
              <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-amber-100 flex items-center justify-center font-bold text-slate-500 group-hover:text-amber-700 transition-colors text-sm">
                {String(post.data.seriesPart ?? i + 1).padStart(2, '0')}
              </div>
            </div>

            {/* Konten */}
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="text-xs text-slate-400 mb-1">
                    Part {post.data.seriesPart ?? i + 1}
                  </div>
                  <h3 class="font-bold text-slate-800 group-hover:text-amber-700 transition-colors text-base leading-snug mb-1">
                    {post.data.title}
                  </h3>
                  <p class="text-slate-500 text-sm leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <div class="flex-shrink-0">
                  <div class="w-8 h-8 rounded-lg bg-slate-100 group-hover:bg-amber-600 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-arrow-right text-slate-400 group-hover:text-white text-xs transition-colors"></i>
                  </div>
                </div>
              </div>

              {/* Meta & counter */}
              <div class="flex items-center gap-4 mt-3 pt-3 border-t border-slate-100">
                <span class="flex items-center gap-1.5 text-xs text-slate-400">
                  <i class="fa-regular fa-calendar"></i>
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <span
                  class="flex items-center gap-1.5 text-xs text-slate-400"
                  data-counter={post.id}
                >
                  <i class="fa-regular fa-eye"></i>
                  <span class="counter-val">...</span> kali dibaca
                </span>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-10 bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-100 rounded-2xl px-6 py-8 text-center">
      <div class="w-12 h-12 rounded-2xl bg-white border border-amber-100 flex items-center justify-center mx-auto mb-4 shadow-sm">
        <i class="fa-solid fa-bell text-amber-500"></i>
      </div>
      <h4 class="font-bold text-slate-700 mb-2">Artikel baru sedang disiapkan</h4>
      <p class="text-slate-500 text-sm">Kunjungi kembali secara berkala untuk membaca kelanjutan seri ini.</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Ambil view count untuk setiap artikel di seri ini
  async function loadCounts() {
    const elements = document.querySelectorAll('[data-counter]');
    await Promise.all(Array.from(elements).map(async (el) => {
      const slug = (el as HTMLElement).dataset.counter;
      const valEl = el.querySelector('.counter-val');
      if (!slug || !valEl) return;
      try {
        const res = await fetch(`https://api.counterapi.dev/v1/rizkyrinaldi-blog/${slug}`);
        const data = await res.json();
        valEl.textContent = (data.count ?? 0).toLocaleString('id-ID');
      } catch {
        valEl.textContent = '—';
      }
    }));
  }
  loadCounts();
</script>
