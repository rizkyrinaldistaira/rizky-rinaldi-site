---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { SITE_URL } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title || 'Blog Post';
const description = post.data.description || SITE_URL;
const ogImage = '/myfoto.jpg';
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonical={`${SITE_URL}/blog/${post.id}`}
  pageType="article"
>
  <article class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8 pt-32">
    <header class="mb-8">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-gold-600 hover:text-gold-700 font-medium mb-6 transition-colors">
        <i class="fa-solid fa-arrow-left text-xs"></i> Kembali ke Blog
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold text-dark mb-4">{title}</h1>
      <div class="text-sm text-slate-500 flex items-center gap-4">
        <FormattedDate date={post.data.pubDate} />
      </div>
    </header>
    <div class="prose prose-lg max-w-none prose-headings:text-dark prose-a:text-gold-600 prose-a:no-underline hover:prose-a:underline prose-strong:text-dark prose-img:rounded-xl prose-img:shadow-lg">
      <Content />
    </div>
  </article>
</BaseLayout>
