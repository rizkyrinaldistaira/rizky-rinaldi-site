---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { SITE_URL, VIEWS_API } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title || 'Blog Post';
const description = post.data.description || '';
const ogImage = '/myfoto.jpg';
const canonical = `${SITE_URL}/blog/${post.id}`;

// Cari artikel seri (prev/next)
let prevPost: CollectionEntry<'blog'> | null = null;
let nextPost: CollectionEntry<'blog'> | null = null;

if (post.data.series) {
  const allPosts = await getCollection('blog');
  const seriesPosts = allPosts
    .filter(p => p.data.series === post.data.series)
    .sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));
  const idx = seriesPosts.findIndex(p => p.id === post.id);
  if (idx > 0) prevPost = seriesPosts[idx - 1];
  if (idx < seriesPosts.length - 1) nextPost = seriesPosts[idx + 1];
}

function seriesSlug(name: string) {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

// JSON-LD Article
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Rizky Rinaldi, S.Kom., M.Kom.',
    url: SITE_URL,
  },
  publisher: {
    '@type': 'Person',
    name: 'Rizky Rinaldi, S.Kom., M.Kom.',
    url: SITE_URL,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};
---

<BaseLayout
  title={`${title} | Blog`}
  description={description}
  ogImage={ogImage}
  canonical={canonical}
  pageType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 pt-32">

    <!-- Breadcrumb / back -->
    <div class="flex items-center gap-2 text-sm text-slate-400 mb-8">
      <a href="/blog" class="hover:text-amber-600 transition-colors">Blog</a>
      {post.data.series && (
        <>
          <i class="fa-solid fa-chevron-right text-[10px]"></i>
          <a href={`/blog/series/${seriesSlug(post.data.series)}`} class="hover:text-amber-600 transition-colors">
            {post.data.series}
          </a>
        </>
      )}
      <i class="fa-solid fa-chevron-right text-[10px]"></i>
      <span class="text-slate-600 truncate">{title}</span>
    </div>

    <!-- Header artikel -->
    <header class="mb-10">
      {post.data.series && (
        <div class="flex items-center gap-2 mb-4">
          <span class="text-xs font-semibold text-amber-600 bg-amber-50 border border-amber-100 px-3 py-1 rounded-full uppercase tracking-wide">
            <i class="fa-solid fa-layer-group mr-1 text-[10px]"></i>
            {post.data.series} — Part {post.data.seriesPart}
          </span>
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-800 leading-tight mb-4">
        {title}
      </h1>

      {description && (
        <p class="text-slate-500 text-lg leading-relaxed mb-6">{description}</p>
      )}

      <!-- Meta info -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-400 pb-6 border-b border-slate-100">
        <span class="flex items-center gap-1.5">
          <i class="fa-regular fa-calendar text-amber-500"></i>
          <FormattedDate date={post.data.pubDate} />
        </span>
        <span class="flex items-center gap-1.5" id="view-counter" style="display:none">
          <i class="fa-regular fa-eye text-amber-500"></i>
          <span id="view-count">...</span> kali dibaca
        </span>
        <span class="flex items-center gap-1.5">
          <i class="fa-solid fa-user-tie text-amber-500"></i>
          Rizky Rinaldi
        </span>
      </div>
    </header>

    <!-- Konten artikel -->
    <div class="prose prose-slate prose-lg max-w-none
      prose-headings:font-bold prose-headings:text-slate-800
      prose-a:text-amber-600 prose-a:no-underline hover:prose-a:underline
      prose-strong:text-slate-800
      prose-img:rounded-xl prose-img:shadow-lg prose-img:border prose-img:border-slate-100
      prose-code:bg-slate-100 prose-code:text-amber-700 prose-code:px-1 prose-code:rounded
      prose-pre:bg-slate-900 prose-pre:rounded-xl
      prose-blockquote:border-amber-400 prose-blockquote:bg-amber-50 prose-blockquote:rounded-r-xl prose-blockquote:py-1
    ">
      <Content />
    </div>

    <!-- Navigasi seri -->
    {post.data.series && (prevPost || nextPost) && (
      <nav class="mt-12 pt-8 border-t border-slate-100">
        <p class="text-xs text-slate-400 uppercase tracking-widest mb-4 font-semibold">Navigasi Seri</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a href={`/blog/${prevPost.id}`}
              class="group flex items-center gap-3 bg-white border border-slate-200 rounded-xl px-4 py-4 hover:border-amber-300 hover:shadow-md transition-all no-underline">
              <div class="w-8 h-8 rounded-lg bg-slate-100 group-hover:bg-amber-100 flex items-center justify-center flex-shrink-0 transition-colors">
                <i class="fa-solid fa-arrow-left text-slate-400 group-hover:text-amber-600 text-xs transition-colors"></i>
              </div>
              <div class="min-w-0">
                <div class="text-[10px] text-slate-400 uppercase tracking-wide mb-0.5">Sebelumnya</div>
                <div class="text-sm font-semibold text-slate-700 group-hover:text-amber-700 transition-colors truncate">
                  {prevPost.data.title}
                </div>
              </div>
            </a>
          ) : <div></div>}
          {nextPost && (
            <a href={`/blog/${nextPost.id}`}
              class="group flex items-center gap-3 bg-white border border-slate-200 rounded-xl px-4 py-4 hover:border-amber-300 hover:shadow-md transition-all no-underline sm:text-right sm:flex-row-reverse">
              <div class="w-8 h-8 rounded-lg bg-slate-100 group-hover:bg-amber-100 flex items-center justify-center flex-shrink-0 transition-colors">
                <i class="fa-solid fa-arrow-right text-slate-400 group-hover:text-amber-600 text-xs transition-colors"></i>
              </div>
              <div class="min-w-0">
                <div class="text-[10px] text-slate-400 uppercase tracking-wide mb-0.5">Selanjutnya</div>
                <div class="text-sm font-semibold text-slate-700 group-hover:text-amber-700 transition-colors truncate">
                  {nextPost.data.title}
                </div>
              </div>
            </a>
          )}
        </div>
        <div class="mt-4 text-center">
          <a href={`/blog/series/${seriesSlug(post.data.series)}`}
            class="inline-flex items-center gap-2 text-sm text-amber-600 hover:text-amber-700 font-medium no-underline">
            <i class="fa-solid fa-layer-group text-xs"></i>
            Lihat semua artikel {post.data.series}
          </a>
        </div>
      </nav>
    )}

  </article>
</BaseLayout>

<script define:vars={{ postId: post.id, viewsApi: VIEWS_API }}>
  // Penghitung kunjungan (Cloudflare Worker + D1).
  // - Tampil hanya jika berhasil memuat angka; bila layanan belum diatur atau gagal, tetap tersembunyi.
  // - Menambah hitungan maksimal 1x per browser per 24 jam (refresh tidak menggandakan).
  // - Buka halaman mana pun dengan ?nocount sekali untuk mengabaikan kunjungan Anda sendiri di browser itu.
  (async function () {
    const box = document.getElementById('view-counter');
    const countEl = document.getElementById('view-count');
    if (!box || !countEl || !viewsApi) return;

    const DAY = 24 * 60 * 60 * 1000;
    const storeKey = 'pv:' + postId;
    let shouldCount = true;
    try {
      if (location.search.indexOf('nocount') !== -1) localStorage.setItem('pv:ignore', '1');
      if (localStorage.getItem('pv:ignore') === '1') shouldCount = false;
      const last = Number(localStorage.getItem(storeKey) || 0);
      if (last && Date.now() - last < DAY) shouldCount = false;
    } catch (e) { /* localStorage tidak tersedia: tetap hitung */ }

    try {
      const url = viewsApi + '/views/' + encodeURIComponent(postId) + (shouldCount ? '/hit' : '');
      const res = await fetch(url, { method: shouldCount ? 'POST' : 'GET' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      countEl.textContent = Number(data.count || 0).toLocaleString('id-ID');
      box.style.display = '';
      if (shouldCount) {
        try { localStorage.setItem(storeKey, String(Date.now())); } catch (e) {}
      }
    } catch (e) {
      /* gagal: biarkan tersembunyi */
    }
  })();
</script>
