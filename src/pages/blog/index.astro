---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';

/* ================= PENGATURAN (silakan ubah) ================= */
const PAGE_SIZE = 8;                 // jumlah kartu artikel per "halaman"
const SERIES_PREVIEW = 4;            // jumlah kartu seri yang tampil sebelum "Tampilkan semua seri"
const LATEST_INCLUDES_SERIES = true; // true: "Artikel Terbaru" memuat juga bagian-bagian seri
const NEW_BADGE_DAYS = 30;           // label "Baru" untuk artikel yang terbit dalam N hari terakhir
const WORDS_PER_MINUTE = 200;        // dasar hitung estimasi waktu baca
const DEFAULT_CATEGORY = 'Umum';     // kategori bila artikel belum punya "category"
const FALLBACK_ICON = 'fa-file-lines';
const CATEGORY_ICONS: Record<string, string> = {
  'Metodologi Penelitian': 'fa-flask',
  'Panduan Skripsi': 'fa-graduation-cap',
  'Pengembangan Sistem': 'fa-code',
  'Umum': 'fa-newspaper',
};
/* ============================================================= */

// Normalisasi teks untuk pencarian (harus sama dengan yang dipakai skrip di bawah)
const norm = (s: string) =>
  (s ?? '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ').trim();
const fmtDate = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const toSlug = (name: string) =>
  name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const minutesOf = (body?: string) =>
  Math.max(1, Math.ceil((body ?? '').split(/\s+/).filter(Boolean).length / WORDS_PER_MINUTE));

const entries = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    a.data.title.localeCompare(b.data.title, 'id')
);
const now = Date.now();

type Item = {
  id: string;
  title: string;
  description: string;
  date: Date;
  minutes: number;
  category: string;
  topicKey: string;
  tags: string[];
  series?: string;
  part?: number;
  seriesDescription?: string;
  seriesIcon?: string;
  icon: string;
  isNew: boolean;
  search: string;
};

const items: Item[] = entries.map((p) => {
  const category = p.data.category ?? DEFAULT_CATEGORY;
  const tags = p.data.tags ?? [];
  return {
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
    minutes: minutesOf(p.body),
    category,
    topicKey: norm(category),
    tags,
    series: p.data.series,
    part: p.data.seriesPart,
    seriesDescription: p.data.seriesDescription,
    seriesIcon: p.data.seriesIcon,
    icon:
      p.data.icon ??
      (p.data.series ? p.data.seriesIcon : undefined) ??
      CATEGORY_ICONS[category] ??
      FALLBACK_ICON,
    isNew: (now - p.data.pubDate.valueOf()) / 86400000 <= NEW_BADGE_DAYS,
    search: norm(
      [
        p.data.title,
        p.data.description,
        category,
        ...tags,
        p.data.series ?? '',
        p.data.seriesPart ? `part ${p.data.seriesPart}` : '',
      ].join(' ')
    ),
  };
});

// ---- Seri ----
type Series = {
  name: string;
  slug: string;
  description?: string;
  icon: string;
  posts: Item[];
  minutes: number;
  topicKeys: string[];
  tagKeys: string[];
  latest: number;
  first: number;
  search: string;
};
const seriesMap = new Map<string, Series>();
for (const it of items) {
  if (!it.series) continue;
  let s = seriesMap.get(it.series);
  if (!s) {
    s = {
      name: it.series,
      slug: toSlug(it.series),
      description: undefined,
      icon: 'fa-book-open',
      posts: [],
      minutes: 0,
      topicKeys: [],
      tagKeys: [],
      latest: 0,
      first: Infinity,
      search: '',
    };
    seriesMap.set(it.series, s);
  }
  s.posts.push(it);
  s.description ??= it.seriesDescription;
  if (it.seriesIcon) s.icon = it.seriesIcon;
}
const seriesList: Series[] = [...seriesMap.values()].map((s) => {
  s.posts.sort((a, b) => (a.part ?? 0) - (b.part ?? 0));
  s.minutes = s.posts.reduce((n, p) => n + p.minutes, 0);
  s.topicKeys = [...new Set(s.posts.map((p) => p.topicKey))];
  s.tagKeys = [...new Set(s.posts.flatMap((p) => p.tags.map(norm)))];
  s.latest = Math.max(...s.posts.map((p) => p.date.valueOf()));
  s.first = Math.min(...s.posts.map((p) => p.date.valueOf()));
  s.search = norm(
    [
      s.name,
      s.description ?? '',
      ...s.posts.map((p) => p.title),
      ...s.posts.flatMap((p) => p.tags),
      ...s.posts.map((p) => p.category),
    ].join(' ')
  );
  return s;
});
seriesList.sort((a, b) => b.latest - a.latest || a.name.localeCompare(b.name, 'id'));

// ---- Topik (kategori) dan tag ----
const topicCounts = new Map<string, { label: string; key: string; count: number; icon: string }>();
for (const it of items) {
  const t = topicCounts.get(it.topicKey);
  if (t) t.count++;
  else
    topicCounts.set(it.topicKey, {
      label: it.category,
      key: it.topicKey,
      count: 1,
      icon: CATEGORY_ICONS[it.category] ?? FALLBACK_ICON,
    });
}
const topics = [...topicCounts.values()].sort(
  (a, b) => b.count - a.count || a.label.localeCompare(b.label, 'id')
);

const tagCounts = new Map<string, { label: string; key: string; count: number }>();
for (const it of items) {
  for (const tag of it.tags) {
    const key = norm(tag);
    if (!key) continue;
    const t = tagCounts.get(key);
    if (t) t.count++;
    else tagCounts.set(key, { label: tag, key, count: 1 });
  }
}
const allTags = [...tagCounts.values()].sort(
  (a, b) => b.count - a.count || a.label.localeCompare(b.label, 'id')
);
const popularTags = allTags.slice(0, 6);

// ---- Statistik dan ajakan "mulai dari sini" ----
const totalMinutes = items.reduce((n, i) => n + i.minutes, 0);
const readingLabel =
  totalMinutes >= 60 ? `${Math.round(totalMinutes / 60)} jam bacaan` : `${totalMinutes} menit bacaan`;
const starter = [...seriesList].sort(
  (a, b) => b.posts.length - a.posts.length || b.latest - a.latest
)[0];

// ---- Data terstruktur (SEO) ----
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog & Pembelajaran | ${SITE_TITLE}`,
  url: `${SITE_URL}/blog`,
  inLanguage: 'id',
  author: { '@type': 'Person', name: 'Rizky Rinaldi, S.Kom., M.Kom.', url: SITE_URL },
  blogPost: items.slice(0, 10).map((i) => ({
    '@type': 'BlogPosting',
    headline: i.title,
    description: i.description,
    datePublished: i.date.toISOString(),
    url: `${SITE_URL}/blog/${i.id}`,
    keywords: i.tags.join(', '),
  })),
};
---

<BaseLayout
  title={`Blog & Pembelajaran | ${SITE_TITLE}`}
  description="Kumpulan artikel, panduan praktis, dan seri pembelajaran seputar teknologi informasi, metodologi penelitian, dan penyusunan skripsi oleh Rizky Rinaldi."
  canonical={`${SITE_URL}/blog`}
  pageType="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div
    class="bf"
    data-page={PAGE_SIZE}
    data-series-preview={SERIES_PREVIEW}
    data-include-series={String(LATEST_INCLUDES_SERIES)}
    data-total-articles={items.length}
    data-total-series={seriesList.length}
  >
    <!-- ====================== HERO ====================== -->
    <section class="relative overflow-hidden bg-white border-b border-slate-100 pt-32 pb-10">
      <div class="bf-glow" aria-hidden="true"></div>
      <div class="relative max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-1 h-7 bg-amber-500 rounded-full"></div>
          <span class="text-amber-600 font-semibold text-xs uppercase tracking-[0.15em]">Blog &amp; Pembelajaran</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-800 mb-4 leading-tight">Ruang Belajar Digital</h1>
        <p class="text-slate-500 text-lg max-w-2xl leading-relaxed">
          Artikel, panduan praktis, dan seri pembelajaran seputar teknologi informasi, metodologi penelitian, dan penyusunan skripsi.
        </p>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-7">
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <i class="fa-solid fa-layer-group text-amber-500"></i>
            <span><strong class="text-slate-700">{seriesList.length}</strong> seri</span>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <i class="fa-solid fa-file-lines text-amber-500"></i>
            <span><strong class="text-slate-700">{items.length}</strong> artikel</span>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <i class="fa-solid fa-tags text-amber-500"></i>
            <span><strong class="text-slate-700">{topics.length}</strong> topik</span>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <i class="fa-regular fa-clock text-amber-500"></i>
            <span>&plusmn; <strong class="text-slate-700">{readingLabel}</strong></span>
          </div>
        </div>

        {starter && (
          <a href={`/blog/${starter.posts[0].id}`} class="bf-starter">
            <span class="bf-starter-icon"><i class="fa-solid fa-compass"></i></span>
            <span>
              Baru di sini? Mulai dari seri <strong>{starter.name}</strong>
            </span>
            <i class="fa-solid fa-arrow-right text-xs"></i>
          </a>
        )}

        <!-- ============ PANEL PENCARIAN DAN FILTER ============ -->
        <div id="finder" class="bf-finder" role="search" aria-label="Cari dan saring artikel" hidden>
          <div class="bf-search">
            <i class="fa-solid fa-magnifying-glass bf-search-icon" aria-hidden="true"></i>
            <label for="q" class="sr-only">Cari artikel, topik, atau tag</label>
            <input
              id="q"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Cari artikel, topik, atau tag..."
            />
            <button type="button" id="q-clear" class="bf-clear" aria-label="Hapus pencarian" hidden>
              <i class="fa-solid fa-xmark"></i>
            </button>
            <kbd class="bf-kbd" aria-hidden="true">/</kbd>
          </div>

          <div class="bf-row">
            <span class="bf-label">Topik</span>
            <div class="bf-chips">
              <button type="button" class="bf-chip" data-topic-chip="" aria-pressed="true">
                <i class="fa-solid fa-border-all"></i> Semua <span class="bf-n">{items.length}</span>
              </button>
              {topics.map((t) => (
                <button type="button" class="bf-chip" data-topic-chip={t.key} aria-pressed="false">
                  <i class={`fa-solid ${t.icon}`}></i> {t.label} <span class="bf-n">{t.count}</span>
                </button>
              ))}
            </div>
          </div>

          <div class="bf-row bf-row-split">
            <div class="bf-segment" role="group" aria-label="Jenis konten">
              <button type="button" data-type-set="semua" aria-pressed="true">Semua</button>
              <button type="button" data-type-set="seri" aria-pressed="false">
                <i class="fa-solid fa-layer-group"></i> Seri
              </button>
              <button type="button" data-type-set="lepas" aria-pressed="false">
                <i class="fa-regular fa-file-lines"></i> Artikel lepas
              </button>
            </div>

            <div class="bf-tools">
              <button type="button" id="tag-toggle" class="bf-chip bf-chip-ghost" aria-expanded="false" aria-controls="tag-panel">
                <i class="fa-solid fa-tags"></i> Tag <span id="tag-count" class="bf-badge-n" hidden></span>
                <i class="fa-solid fa-chevron-down bf-caret"></i>
              </button>
              <label for="sort" class="sr-only">Urutkan</label>
              <div class="bf-select">
                <i class="fa-solid fa-arrow-down-wide-short"></i>
                <select id="sort">
                  <option value="terbaru">Terbaru</option>
                  <option value="terlama">Terlama</option>
                  <option value="judul">Judul A&ndash;Z</option>
                </select>
              </div>
            </div>
          </div>

          <div id="tag-panel" class="bf-tagpanel" hidden>
            <span class="bf-label">Semua tag</span>
            <div class="bf-chips bf-chips-wrap">
              {allTags.map((t) => (
                <button type="button" class="bf-chip bf-chip-sm" data-tag-toggle={t.key} aria-pressed="false">
                  #{t.label} <span class="bf-n">{t.count}</span>
                </button>
              ))}
            </div>
          </div>

          {popularTags.length > 0 && (
            <div class="bf-row bf-row-pop">
              <span class="bf-label">Populer</span>
              <div class="bf-chips">
                {popularTags.map((t) => (
                  <button type="button" class="bf-chip bf-chip-sm" data-tag-toggle={t.key} aria-pressed="false">
                    #{t.label}
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="bf-foot">
            <p id="status" class="bf-status" role="status" aria-live="polite"></p>
            <button type="button" id="reset" class="bf-reset" hidden>
              <i class="fa-solid fa-rotate-left"></i> Hapus semua filter
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================== HASIL ====================== -->
    <div class="max-w-5xl mx-auto px-6 py-12">

      <!-- SERI -->
      <section id="series-section" class="mb-14">
        <div class="bf-head">
          <div class="bf-head-icon"><i class="fa-solid fa-layer-group"></i></div>
          <div>
            <h2 class="bf-h2">Seri Pembelajaran</h2>
            <p class="bf-sub">Materi terstruktur dan berurutan <span id="series-count"></span></p>
          </div>
        </div>

        <div id="series-grid" class="bf-grid">
          {seriesList.map((s) => (
            <article
              class="bf-card"
              data-card
              data-type="seri"
              data-s={s.search}
              data-topic={s.topicKeys.join('|')}
              data-tags={s.tagKeys.join('|')}
              data-date={s.latest}
              data-first={s.first}
              data-name={norm(s.name)}
            >
              <div class="bf-bar"></div>
              <div class="flex items-start gap-4">
                <div class="bf-tile"><i class={`fa-solid ${s.icon}`}></i></div>
                <div class="min-w-0 flex-1">
                  <div class="bf-badges">
                    <span class="bf-badge bf-badge-amber"><i class="fa-solid fa-layer-group"></i> Seri Pembelajaran</span>
                  </div>
                  <h3 class="bf-title">
                    <a class="bf-stretch" href={`/blog/series/${s.slug}`} data-title-text data-raw={s.name}>{s.name}</a>
                  </h3>
                  {s.description && <p class="bf-desc bf-clamp2">{s.description}</p>}
                  <ol class="bf-parts">
                    {s.posts.slice(0, 3).map((p) => (
                      <li><span>{String(p.part ?? '').padStart(2, '0')}</span>{p.title}</li>
                    ))}
                    {s.posts.length > 3 && <li class="bf-parts-more">+ {s.posts.length - 3} artikel lainnya</li>}
                  </ol>
                  <div class="bf-foot-row">
                    <span class="bf-meta">
                      <i class="fa-solid fa-list-ol"></i> {s.posts.length} artikel
                      <span class="bf-dot"></span>
                      <i class="fa-regular fa-clock"></i> &plusmn;{s.minutes} menit
                    </span>
                    <span class="bf-go">Lihat seri <i class="fa-solid fa-arrow-right"></i></span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-6">
          <button type="button" id="series-more" class="bf-more" hidden>
            <span id="series-more-label">Tampilkan semua seri</span> <i class="fa-solid fa-chevron-down"></i>
          </button>
        </div>
      </section>

      <!-- ARTIKEL -->
      <section id="articles-section">
        <div class="bf-head bf-head-between">
          <div class="flex items-center gap-3">
            <div class="bf-head-icon bf-head-icon-slate"><i class="fa-solid fa-newspaper"></i></div>
            <div>
              <h2 id="articles-title" class="bf-h2">Artikel Terbaru</h2>
              <p id="articles-sub" class="bf-sub"></p>
            </div>
          </div>
        </div>

        <div id="articles-grid" class="bf-grid">
          {items.map((it) => (
            <article
              class="bf-card"
              data-card
              data-type={it.series ? 'seri' : 'lepas'}
              data-s={it.search}
              data-topic={it.topicKey}
              data-tags={it.tags.map(norm).join('|')}
              data-date={it.date.valueOf()}
              data-name={norm(it.title)}
            >
              <div class="bf-bar"></div>
              <div class="flex items-start gap-4">
                <div class="bf-tile"><i class={`fa-solid ${it.icon}`}></i></div>
                <div class="min-w-0 flex-1">
                  <div class="bf-badges">
                    {it.series ? (
                      <span class="bf-badge bf-badge-amber">
                        <i class="fa-solid fa-layer-group"></i> Seri{it.part ? <> &middot; Part {it.part}</> : ''}
                      </span>
                    ) : (
                      <span class="bf-badge bf-badge-slate">
                        <i class="fa-regular fa-file-lines"></i> Artikel lepas
                      </span>
                    )}
                    {it.isNew && <span class="bf-badge bf-badge-new">Baru</span>}
                  </div>
                  <h3 class="bf-title">
                    <a class="bf-stretch" href={`/blog/${it.id}`} data-title-text data-raw={it.title}>{it.title}</a>
                  </h3>
                  <p class="bf-desc bf-clamp3">{it.description}</p>

                  {it.series && <p class="bf-from"><i class="fa-solid fa-turn-up"></i> dari seri {it.series}</p>}

                  <div class="bf-meta bf-meta-wrap">
                    <span><i class="fa-regular fa-calendar"></i> <time datetime={it.date.toISOString()}>{fmtDate(it.date)}</time></span>
                    <span class="bf-dot"></span>
                    <span><i class="fa-regular fa-clock"></i> {it.minutes} menit baca</span>
                    <span class="bf-dot"></span>
                    <button type="button" class="bf-catbtn" data-topic-set={it.topicKey}>
                      <i class="fa-regular fa-folder"></i> {it.category}
                    </button>
                  </div>

                  {it.tags.length > 0 && (
                    <div class="bf-tags">
                      {it.tags.slice(0, 3).map((tag) => (
                        <button type="button" class="bf-tag" data-tag-toggle={norm(tag)} aria-pressed="false">#{tag}</button>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center mt-8">
          <button type="button" id="more" class="bf-more" hidden>
            <span id="more-label">Tampilkan lebih banyak</span> <i class="fa-solid fa-arrow-down"></i>
          </button>
        </div>
      </section>

      <!-- KOSONG -->
      <div id="empty" class="bf-empty" hidden>
        <div class="bf-empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
        <h3>Tidak ada yang cocok <span id="empty-query"></span></h3>
        <p>Coba kata kunci yang lebih singkat, periksa ejaan, atau kurangi filter yang aktif.</p>
        <button type="button" id="reset-empty" class="bf-more"><i class="fa-solid fa-rotate-left"></i> Hapus semua filter</button>
        {popularTags.length > 0 && (
          <div class="bf-empty-tags">
            <span>Atau coba:</span>
            {popularTags.slice(0, 4).map((t) => (
              <button type="button" class="bf-chip bf-chip-sm" data-tag-toggle={t.key} aria-pressed="false">#{t.label}</button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .bf [hidden] { display: none !important; }

  /* ---------- Hero ---------- */
  .bf-glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(55% 60% at 88% 0%, rgba(251, 191, 36, .20), transparent 62%),
      radial-gradient(40% 45% at 0% 100%, rgba(245, 158, 11, .10), transparent 62%);
  }
  .bf-starter {
    display: inline-flex; align-items: center; gap: .65rem; margin-top: 1.4rem;
    padding: .45rem .9rem .45rem .5rem; border-radius: 999px; text-decoration: none;
    background: #fffbeb; border: 1px solid #fde68a; color: #92400e; font-size: .85rem;
    transition: box-shadow .2s, transform .2s;
  }
  .bf-starter:hover { box-shadow: 0 6px 18px -8px rgba(217, 119, 6, .45); transform: translateY(-1px); }
  .bf-starter-icon {
    width: 1.7rem; height: 1.7rem; border-radius: 999px; background: #f59e0b; color: #fff;
    display: inline-flex; align-items: center; justify-content: center; font-size: .78rem;
  }

  /* ---------- Panel pencarian ---------- */
  .bf-finder {
    margin-top: 2rem; padding: 1rem; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 1.25rem; box-shadow: 0 18px 40px -22px rgba(15, 23, 42, .28);
    scroll-margin-top: 6rem;
  }
  .bf-search { position: relative; display: flex; align-items: center; }
  .bf-search input {
    width: 100%; font-size: 1rem; color: #1e293b; background: #f8fafc;
    border: 1px solid #e2e8f0; border-radius: .95rem; outline: none;
    padding: .9rem 4rem .9rem 2.8rem; transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .bf-search input::placeholder { color: #94a3b8; }
  .bf-search input:focus { background: #fff; border-color: #f59e0b; box-shadow: 0 0 0 4px rgba(245, 158, 11, .16); }
  .bf-search input::-webkit-search-cancel-button { display: none; }
  .bf-search-icon { position: absolute; left: 1.05rem; color: #94a3b8; pointer-events: none; }
  .bf-kbd {
    position: absolute; right: .9rem; font: 600 .72rem/1 ui-monospace, monospace; color: #94a3b8;
    border: 1px solid #e2e8f0; border-bottom-width: 2px; border-radius: .4rem; padding: .25rem .45rem; background: #fff;
  }
  .bf-clear {
    position: absolute; right: .55rem; width: 2rem; height: 2rem; border: 0; border-radius: 999px;
    background: #f1f5f9; color: #64748b; cursor: pointer; z-index: 1;
  }
