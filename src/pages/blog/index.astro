    display: flex; align-items: center; justify-content: center; font-size: .85rem; flex: none;
  }
  .bf-head-icon-slate { background: #f1f5f9; color: #64748b; }
  .bf-h2 { font-size: 1.15rem; font-weight: 700; color: #1e293b; line-height: 1.25; }
  .bf-sub { font-size: .75rem; color: #94a3b8; }

  /* ---------- Kartu ---------- */
  .bf-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 640px) { .bf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .bf-card {
    position: relative; overflow: hidden; background: #fff; border: 1px solid #e2e8f0;
    border-radius: 1rem; padding: 1.35rem 1.4rem; transition: border-color .25s, box-shadow .25s, transform .25s;
  }
  .bf-card:hover, .bf-card:focus-within {
    border-color: #fcd34d; transform: translateY(-2px); box-shadow: 0 16px 34px -18px rgba(217, 119, 6, .35);
  }
  .bf-bar { position: absolute; inset: 0 0 auto 0; height: 2px; background: linear-gradient(90deg, #fbbf24, #fde68a); opacity: 0; transition: opacity .25s; }
  .bf-card:hover .bf-bar, .bf-card:focus-within .bf-bar { opacity: 1; }
  .bf-tile {
    width: 3rem; height: 3rem; flex: none; border-radius: .9rem; background: #fffbeb; border: 1px solid #fde68a;
    color: #d97706; display: flex; align-items: center; justify-content: center; transition: background .25s;
  }
  .bf-card:hover .bf-tile { background: #fef3c7; }
  .bf-badges { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .5rem; }
  .bf-badge {
    display: inline-flex; align-items: center; gap: .35rem; font-size: .68rem; font-weight: 600; letter-spacing: .02em;
    padding: .18rem .55rem; border-radius: 999px;
  }
  .bf-badge i { font-size: .62rem; }
  .bf-badge-amber { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
  .bf-badge-slate { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
  .bf-badge-new { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
  .bf-title { font-size: 1.02rem; font-weight: 700; line-height: 1.38; color: #1e293b; margin-bottom: .4rem; }
  .bf-title a { color: inherit; text-decoration: none; transition: color .2s; }
  .bf-card:hover .bf-title a { color: #b45309; }
  .bf-stretch::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .bf-title a:focus-visible { outline: none; }
  .bf-card:focus-within { outline: 2px solid #f59e0b; outline-offset: 2px; }
  .bf-desc { font-size: .86rem; line-height: 1.6; color: #64748b; }
  .bf-clamp2, .bf-clamp3 { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .bf-clamp2 { -webkit-line-clamp: 2; }
  .bf-clamp3 { -webkit-line-clamp: 3; }
  .bf-from { margin-top: .5rem; font-size: .74rem; color: #94a3b8; }
  .bf-from i { font-size: .65rem; margin-right: .2rem; transform: rotate(90deg); display: inline-block; }
  .bf-parts { list-style: none; margin: .75rem 0 0; padding: 0; display: grid; gap: .3rem; }
  .bf-parts li { font-size: .78rem; color: #64748b; display: flex; gap: .55rem; line-height: 1.4; }
  .bf-parts li span { font-weight: 700; color: #d97706; font-variant-numeric: tabular-nums; }
  .bf-parts-more { color: #94a3b8 !important; padding-left: 1.6rem; }
  .bf-foot-row { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-top: .9rem; padding-top: .75rem; border-top: 1px solid #f1f5f9; }
  .bf-meta { display: flex; align-items: center; gap: .4rem; font-size: .74rem; color: #94a3b8; }
  .bf-meta-wrap { flex-wrap: wrap; margin-top: .75rem; row-gap: .25rem; }
  .bf-meta i { margin-right: .2rem; }
  .bf-dot { width: 3px; height: 3px; border-radius: 99px; background: #cbd5e1; }
  .bf-go { font-size: .76rem; font-weight: 600; color: #d97706; display: inline-flex; align-items: center; gap: .3rem; transition: gap .2s; }
  .bf-card:hover .bf-go { gap: .55rem; }
  .bf-catbtn, .bf-tag { position: relative; z-index: 2; cursor: pointer; border: 0; }
  .bf-catbtn { background: transparent; padding: 0; font-size: .74rem; color: #94a3b8; }
  .bf-catbtn:hover { color: #d97706; }
  .bf-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .75rem; }
  .bf-tag { font-size: .72rem; padding: .16rem .55rem; border-radius: 999px; background: #f1f5f9; color: #64748b; transition: all .15s; }
  .bf-tag:hover { background: #fef3c7; color: #b45309; }
  .bf-tag[aria-pressed="true"] { background: #f59e0b; color: #fff; }
  .bf-title mark { background: #fde68a; color: inherit; border-radius: .2rem; padding: 0 .1rem; }

  /* ---------- Tombol muat lebih, kosong ---------- */
  .bf-more {
    display: inline-flex; align-items: center; gap: .55rem; cursor: pointer; font-size: .88rem; font-weight: 600;
    color: #b45309; background: #fff; border: 1px solid #fcd34d; border-radius: 999px; padding: .65rem 1.4rem; transition: all .2s;
  }
  .bf-more:hover { background: #fffbeb; box-shadow: 0 8px 20px -12px rgba(217, 119, 6, .6); }
  .bf-empty { text-align: center; padding: 3rem 1rem; background: #fff; border: 1px dashed #e2e8f0; border-radius: 1.25rem; }
  .bf-empty-icon { width: 3.5rem; height: 3.5rem; margin: 0 auto 1rem; border-radius: 1rem; background: #f8fafc; color: #cbd5e1; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
  .bf-empty h3 { font-weight: 700; color: #334155; }
  .bf-empty p { font-size: .88rem; color: #94a3b8; margin: .35rem 0 1.2rem; }
  .bf-empty-tags { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .45rem; margin-top: 1.2rem; font-size: .8rem; color: #94a3b8; }

  @media (max-width: 719px) {
    .bf-row { flex-direction: column; align-items: stretch; gap: .4rem; }
    .bf-row-split { flex-direction: row; align-items: center; }
    .bf-kbd { display: none; }
    .bf-segment button { padding: .38rem .6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .bf *, .bf *::before, .bf *::after { transition: none !important; } }
</style>

<script>
  const root = document.querySelector('.bf');
  if (root) {
    const PAGE = Number(root.dataset.page) || 8;
    const SERIES_PREVIEW = Number(root.dataset.seriesPreview) || 4;
    const INCLUDE_SERIES = root.dataset.includeSeries === 'true';
    const TOTAL_A = Number(root.dataset.totalArticles) || 0;
    const TOTAL_S = Number(root.dataset.totalSeries) || 0;

    const $ = (s) => root.querySelector(s);
    const $$ = (s) => Array.from(root.querySelectorAll(s));
    const el = {
      finder: $('#finder'), q: $('#q'), clear: $('#q-clear'), status: $('#status'), reset: $('#reset'),
      sort: $('#sort'), tagPanel: $('#tag-panel'), tagToggle: $('#tag-toggle'), tagCount: $('#tag-count'),
      seriesSection: $('#series-section'), seriesGrid: $('#series-grid'), seriesCount: $('#series-count'),
      seriesMore: $('#series-more'), seriesMoreLabel: $('#series-more-label'),
      articlesSection: $('#articles-section'), articlesGrid: $('#articles-grid'),
      articlesTitle: $('#articles-title'), articlesSub: $('#articles-sub'),
      more: $('#more'), moreLabel: $('#more-label'), empty: $('#empty'), emptyQuery: $('#empty-query'),
    };
    const seriesCards = $$('#series-grid > [data-card]');
    const articleCards = $$('#articles-grid > [data-card]');

    const norm = (s) =>
      (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ').trim();
    const escapeRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const knownTopics = new Set($$('[data-topic-chip]').map((b) => b.dataset.topicChip));
    const knownTags = new Set($$('[data-tag-toggle]').map((b) => b.dataset.tagToggle));

    const state = { q: '', topic: '', type: 'semua', tags: [], sort: 'terbaru', shown: PAGE, allSeries: false };
    let terms = [];

    // ---------- URL <-> state ----------
    function readURL() {
      const p = new URLSearchParams(location.search);
      state.q = (p.get('q') || '').slice(0, 120);
      const topic = norm(p.get('topik') || '');
      state.topic = knownTopics.has(topic) ? topic : '';
      const jenis = p.get('jenis');
      state.type = jenis === 'seri' || jenis === 'lepas' ? jenis : 'semua';
      state.tags = (p.get('tag') || '').split(',').map(norm).filter((t) => knownTags.has(t));
      const urut = p.get('urut');
      state.sort = urut === 'terlama' || urut === 'judul' ? urut : 'terbaru';
    }
    function writeURL() {
      const p = new URLSearchParams();
      if (state.q) p.set('q', state.q);
      if (state.topic) p.set('topik', state.topic);
      if (state.type !== 'semua') p.set('jenis', state.type);
      if (state.tags.length) p.set('tag', state.tags.join(','));
      if (state.sort !== 'terbaru') p.set('urut', state.sort);
      const qs = p.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : ''));
    }

    // ---------- pencocokan ----------
    function matches(card) {
      const s = card.dataset.s || '';
      for (const t of terms) if (!s.includes(t)) return false;
      if (state.topic && !(card.dataset.topic || '').split('|').includes(state.topic)) return false;
      if (state.tags.length) {
        const ct = (card.dataset.tags || '').split('|');
        for (const g of state.tags) if (!ct.includes(g)) return false;
      }
      return true;
    }

    // ---------- sorotan kata kunci pada judul ----------
    function paintTitle(card, hits) {
      const a = card.querySelector('[data-title-text]');
      if (!a) return;
      const raw = a.dataset.raw || '';
      if (!hits.length) {
        if (a.textContent !== raw) a.textContent = raw;
        return;
      }
      const re = new RegExp('(' + hits.map(escapeRe).join('|') + ')', 'gi');
      const frag = document.createDocumentFragment();
      raw.split(re).forEach((part, i) => {
        if (!part) return;
        if (i % 2 === 1) {
          const m = document.createElement('mark');
          m.textContent = part;
          frag.appendChild(m);
        } else frag.appendChild(document.createTextNode(part));
      });
      a.replaceChildren(frag);
    }

    const sorters = {
      terbaru: (a, b) => Number(b.dataset.date) - Number(a.dataset.date),
      terlama: (a, b) => Number(a.dataset.date) - Number(b.dataset.date),
      judul: (a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || '', 'id'),
    };
    const seriesSorters = {
      terbaru: sorters.terbaru,
      terlama: (a, b) => Number(a.dataset.first) - Number(b.dataset.first),
      judul: sorters.judul,
    };

    // ---------- render ----------
    function apply(opts) {
      if (!opts || opts.reset !== false) state.shown = PAGE;
      terms = norm(state.q).split(' ').filter(Boolean);
      const filtering = terms.length > 0 || !!state.topic || state.tags.length > 0;
      const browse = !filtering && state.type === 'semua';

      // Seri
      const sSorted = seriesCards.slice().sort(seriesSorters[state.sort]);
      sSorted.forEach((c) => el.seriesGrid.appendChild(c));
      const seriesLimit = browse && !state.allSeries ? SERIES_PREVIEW : Infinity;
      let sVisible = 0;
      let sShown = 0;
      sSorted.forEach((c) => {
        const ok = state.type !== 'lepas' && matches(c);
        if (ok) {
          sVisible++;
          c.hidden = sShown >= seriesLimit;
          if (!c.hidden) sShown++;
        } else c.hidden = true;
        paintTitle(c, ok && !c.hidden ? terms : []);
      });
      el.seriesMore.hidden = !(browse && sVisible > SERIES_PREVIEW);
      el.seriesMoreLabel.textContent = state.allSeries ? 'Ringkas daftar seri' : 'Tampilkan semua seri (' + sVisible + ')';

      // Artikel
      const aSorted = articleCards.slice().sort(sorters[state.sort]);
      aSorted.forEach((c) => el.articlesGrid.appendChild(c));
      let matched = 0;
      aSorted.forEach((c) => {
        let ok = matches(c);
        if (ok && state.type === 'seri' && c.dataset.type !== 'seri') ok = false;
        if (ok && state.type === 'lepas' && c.dataset.type !== 'lepas') ok = false;
        if (ok && browse && !INCLUDE_SERIES && c.dataset.type === 'seri') ok = false;
        if (ok) {
          matched++;
          c.hidden = matched > state.shown;
        } else c.hidden = true;
        paintTitle(c, ok ? terms : []);
      });

      el.seriesSection.hidden = sVisible === 0;
      el.articlesSection.hidden = matched === 0;
      el.empty.hidden = !(matched === 0 && sVisible === 0);
      el.seriesCount.textContent = filtering || state.type !== 'semua' ? '· ' + sVisible + ' cocok' : '';

      el.articlesTitle.textContent = filtering
        ? 'Hasil Penelusuran'
        : state.sort === 'terbaru' ? 'Artikel Terbaru' : 'Semua Artikel';
      el.articlesSub.textContent = 'Menampilkan ' + Math.min(matched, state.shown) + ' dari ' + matched + ' artikel';

      const remaining = matched - state.shown;
      el.more.hidden = remaining <= 0;
      if (remaining > 0) el.moreLabel.textContent = 'Tampilkan ' + Math.min(PAGE, remaining) + ' artikel lagi (' + remaining + ' tersisa)';

      const active = filtering || state.type !== 'semua';
      el.status.textContent = active
        ? 'Ditemukan ' + matched + ' artikel' + (sVisible ? ' dan ' + sVisible + ' seri' : '') + '.'
        : TOTAL_A + ' artikel dalam ' + TOTAL_S + ' seri dan tulisan lepas.';
      el.emptyQuery.textContent = state.q ? 'untuk \u201C' + state.q + '\u201D' : '';

      // sinkronkan kontrol
      if (el.q.value !== state.q) el.q.value = state.q;
      el.clear.hidden = !state.q;
      $$('[data-topic-chip]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topicChip === state.topic)));
      $$('[data-type-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.typeSet === state.type)));
      $$('[data-tag-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(state.tags.includes(b.dataset.tagToggle))));
      el.sort.value = state.sort;
      el.tagCount.textContent = String(state.tags.length);
      el.tagCount.hidden = state.tags.length === 0;
      el.reset.hidden = !(active || state.sort !== 'terbaru');
      writeURL();
    }

    function resetAll() {
      state.q = ''; state.topic = ''; state.type = 'semua'; state.tags = []; state.sort = 'terbaru'; state.allSeries = false;
      apply();
    }
    function toFinder() {
      el.finder.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }

    // ---------- interaksi ----------
    root.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b || !root.contains(b)) return;
      const fromCard = !!b.closest('[data-card]');

      if ('topicChip' in b.dataset) { state.topic = b.dataset.topicChip; return apply(); }
      if ('topicSet' in b.dataset) {
        state.topic = state.topic === b.dataset.topicSet ? '' : b.dataset.topicSet;
        apply(); if (fromCard) toFinder(); return;
      }
      if ('tagToggle' in b.dataset) {
        const k = b.dataset.tagToggle;
        state.tags = state.tags.includes(k) ? state.tags.filter((t) => t !== k) : state.tags.concat(k);
        apply(); if (fromCard || b.closest('#empty')) toFinder(); return;
      }
      if ('typeSet' in b.dataset) { state.type = b.dataset.typeSet; return apply(); }

      switch (b.id) {
        case 'reset':
        case 'reset-empty': resetAll(); break;
        case 'more': state.shown += PAGE; apply({ reset: false }); break;
        case 'series-more': state.allSeries = !state.allSeries; apply({ reset: false }); break;
        case 'q-clear': state.q = ''; el.q.focus(); apply(); break;
        case 'tag-toggle': {
          const open = el.tagToggle.getAttribute('aria-expanded') !== 'true';
          el.tagToggle.setAttribute('aria-expanded', String(open));
          el.tagPanel.hidden = !open;
          break;
        }
      }
    });

    let timer;
    el.q.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => { state.q = el.q.value.trim().slice(0, 120); apply(); }, 120);
    });
    el.q.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (el.q.value) { el.q.value = ''; state.q = ''; apply(); } else el.q.blur();
      }
    });
    el.sort.addEventListener('change', () => { state.sort = el.sort.value; apply(); });

    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
      e.preventDefault();
      el.q.focus();
      el.q.select();
    });

    // ---------- mulai ----------
    readURL();
    el.q.value = state.q;
    if (state.tags.length) { el.tagPanel.hidden = false; el.tagToggle.setAttribute('aria-expanded', 'true'); }
    el.finder.hidden = false;
    apply();
  }
</script>
