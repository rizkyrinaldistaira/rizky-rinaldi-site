---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const seriesPosts = allPosts.filter(p => p.data.series);
const standalonePosts = allPosts.filter(p => !p.data.series);

const seriesMap: Record<string, typeof allPosts> = {};
for (const post of seriesPosts) {
  const key = post.data.series!;
  if (!seriesMap[key]) seriesMap[key] = [];
  seriesMap[key].push(post);
}
for (const key in seriesMap) {
  seriesMap[key].sort((a, b) => (a.data.seriesPart ?? 0) - (b.data.seriesPart ?? 0));
}
---

<BaseLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <main class="max-w-4xl mx-auto px-4 py-12 pt-32">
    <h1 class="text-3xl font-bold mb-2">📚 Blog</h1>
    <p class="text-slate-500 mb-8">Artikel tutorial, seri pembelajaran, dan tips praktis.</p>

    <!-- SERI PEMBELAJARAN -->
    <div class="text-xl font-bold mt-10 mb-4 border-b-2 border-yellow-500 pb-2">🗂️ Seri Pembelajaran</div>
    {Object.keys(seriesMap).length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {Object.entries(seriesMap).map(([seriesName, posts]) => (
          <a href={`/blog/${posts[0].id}`}
            class="border border-slate-200 rounded-xl p-5 hover:shadow-lg transition-shadow no-underline text-inherit">
            <h3 class="font-semibold text-lg mb-1">{seriesName}</h3>
            <div class="text-sm text-slate-400 mb-2">{posts.length} artikel</div>
            <div class="text-sm text-slate-500 space-y-1">
              {posts.slice(0, 3).map((p) => (
                <div>Part {p.data.seriesPart}: {p.data.title}</div>
              ))}
              {posts.length > 3 && <div>...dan {posts.length - 3} lagi</div>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-slate-400 text-sm">Belum ada seri. Segera hadir!</p>
    )}

    <!-- ARTIKEL LEPAS -->
    <div class="text-xl font-bold mt-10 mb-4 border-b-2 border-yellow-500 pb-2">📝 Artikel Terbaru</div>
    {standalonePosts.length > 0 ? (
      <ul class="space-y-3">
        {standalonePosts.map(post => (
          <li class="flex justify-between items-baseline border-b border-slate-100 pb-3">
            <a href={`/blog/${post.id}`} class="font-medium hover:underline">{post.data.title}</a>
            <span class="text-sm text-slate-400 whitespace-nowrap ml-4">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-slate-400 text-sm">Belum ada artikel lepas.</p>
    )}
  </main>
</BaseLayout>
