---
// Markup PDF ke Gambar. Logika: src/scripts/tools/pdf-ke-gambar.ts
---

<div id="pg">
  <div class="tl-drop" id="pg-drop" tabindex="0" role="button" aria-label="Pilih file PDF untuk diubah menjadi gambar">
    <i class="fa-solid fa-file-pdf text-3xl text-gold-600" aria-hidden="true"></i>
    <p class="font-semibold text-slate-700">Tarik file PDF ke sini atau klik untuk memilih</p>
    <p class="text-sm text-slate-500">Satu file PDF per proses.</p>
    <input type="file" class="hidden" id="pg-file" />
  </div>
  <div id="pg-status" class="hidden mt-4"></div>

  <div id="pg-opts" class="hidden mt-5">
    <p id="pg-info" class="text-sm font-semibold text-slate-700"></p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <label class="tl-label" for="pg-format">Format</label>
        <select id="pg-format" class="tl-input">
          <option value="jpeg">JPG (file lebih kecil)</option>
          <option value="png">PNG (teks paling tajam)</option>
        </select>
      </div>
      <div>
        <label class="tl-label" for="pg-dpi">Kejernihan</label>
        <select id="pg-dpi" class="tl-input">
          <option value="100">100 dpi (ringan)</option>
          <option value="150" selected>150 dpi (layar)</option>
          <option value="200">200 dpi</option>
          <option value="300">300 dpi (cetak)</option>
        </select>
      </div>
      <div id="pg-qwrap">
        <label class="tl-label" for="pg-q">Kualitas JPG: <span id="pg-qv">90</span>%</label>
        <input id="pg-q" type="range" min="50" max="100" value="90" class="w-full" />
      </div>
      <div>
        <label class="tl-label" for="pg-pages">Halaman (kosong = semua)</label>
        <input id="pg-pages" type="text" inputmode="text" placeholder="Contoh: 1-3, 5" class="tl-input" autocomplete="off" />
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" id="pg-run" class="tl-btn"><i class="fa-solid fa-images" aria-hidden="true"></i> Ubah ke gambar</button>
      <button type="button" id="pg-cancel" class="tl-ghost hidden">Hentikan</button>
      <button type="button" id="pg-zip" class="tl-ghost hidden"><i class="fa-solid fa-file-zipper" aria-hidden="true"></i> Unduh semua (ZIP)</button>
      <button type="button" id="pg-clear" class="tl-ghost">Hapus</button>
    </div>
    <p id="pg-progress" class="mt-3 text-sm text-slate-600" aria-live="polite"></p>
  </div>
  <div id="pg-results" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"></div>
</div>

<script>
  import '../scripts/tools/pdf-ke-gambar.ts';
</script>
