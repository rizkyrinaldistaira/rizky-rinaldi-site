---
// Markup Cronbach's Alpha. Logika: src/scripts/tools/cronbach-alpha.ts, rumus: formulas.ts
---

<div id="ca">
  <label class="tl-label" for="ca-data">Data angket (satu baris per responden, satu kolom per butir)</label>
  <textarea id="ca-data" rows="8" class="tl-input font-mono" style="font-size:0.85rem" placeholder="Tempel dari Excel di sini, misalnya:&#10;4&#9;5&#9;4&#9;5&#10;3&#9;3&#9;4&#9;3&#10;5&#9;5&#9;5&#9;4" spellcheck="false"></textarea>
  <div class="mt-3 grid gap-4 sm:grid-cols-3">
    <div class="sm:col-span-1">
      <label class="tl-label" for="ca-rev">Butir dibalik skornya (nomor, pisah koma)</label>
      <input id="ca-rev" type="text" class="tl-input" placeholder="mis. 3, 7" />
    </div>
    <div>
      <label class="tl-label" for="ca-min">Skor terendah skala</label>
      <input id="ca-min" type="number" step="1" value="1" class="tl-input" />
    </div>
    <div>
      <label class="tl-label" for="ca-max">Skor tertinggi skala</label>
      <input id="ca-max" type="number" step="1" value="5" class="tl-input" />
    </div>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button type="button" id="ca-run" class="tl-btn"><i class="fa-solid fa-calculator" aria-hidden="true"></i> Hitung</button>
    <button type="button" id="ca-sample" class="tl-ghost">Pakai data contoh</button>
    <button type="button" id="ca-clear" class="tl-ghost">Kosongkan</button>
  </div>
  <div id="ca-msg" class="hidden mt-4"></div>
  <div id="ca-out" class="mt-6" aria-live="polite"></div>
</div>

<script>
  import '../scripts/tools/cronbach-alpha.ts';
</script>
