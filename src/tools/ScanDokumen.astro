---
// Markup Scan Dokumen. Logika: src/scripts/tools/scan-dokumen.ts. Mesin: scan-detect, scan-warp, scan-effects, scan-core.
import { FILTERS } from '../scripts/tools/scan-effects.ts';
---

<div id="sc">
  <div class="tl-drop" id="sc-drop" tabindex="0" role="button" aria-label="Pilih foto dokumen atau PDF">
    <i class="fa-solid fa-camera text-3xl text-gold-600" aria-hidden="true"></i>
    <p class="font-semibold text-slate-700">Tarik foto dokumen atau PDF ke sini, atau klik untuk memilih</p>
    <p class="text-sm text-slate-500">Foto dipotong dan diluruskan otomatis. Bisa banyak file sekaligus.</p>
    <input type="file" class="hidden" id="sc-file" />
  </div>
  <div id="sc-status" class="hidden"></div>
  <div id="sc-live" class="sr-only" aria-live="polite"></div>

  <div id="sc-opts" class="hidden mt-6">
    <p id="sc-filter-label" class="tl-label">Filter</p>
    <div id="sc-filters" role="radiogroup" aria-labelledby="sc-filter-label" class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {
        FILTERS.map((f) => (
          <button type="button" role="radio" aria-checked={f.id === 'ajaib' ? 'true' : 'false'} tabindex={f.id === 'ajaib' ? 0 : -1} class="tl-effect" data-filter={f.id}>
            <strong>{f.name}</strong>
            <span>{f.desc}</span>
          </button>
        ))
      }
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <div>
        <label class="tl-label" for="sc-quality">Ketajaman hasil</label>
        <select id="sc-quality" class="tl-input">
          <option value="standar">Standar (file ringan)</option>
          <option value="tajam" selected>Tajam (disarankan)</option>
          <option value="maksimal">Maksimal (file besar)</option>
        </select>
      </div>
      <div>
        <label class="tl-label" for="sc-aspect">Ukuran halaman</label>
        <select id="sc-aspect" class="tl-input">
          <option value="auto" selected>Otomatis dari foto</option>
          <option value="a4">Paksa A4</option>
          <option value="letter">Paksa Letter</option>
          <option value="f4">Paksa F4 (folio)</option>
        </select>
      </div>
      <div class="flex items-end"><button type="button" id="sc-clear" class="tl-ghost">Hapus semua</button></div>
    </div>
  </div>

  <div id="sc-results" class="hidden mt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="text-lg font-bold text-slate-800">Hasil scan</h2>
      <p id="sc-summary" class="text-sm text-slate-500"></p>
    </div>
    <p class="mt-1 text-xs text-slate-500">Klik gambar untuk memperbesar. Tepi meleset? Klik ikon potong untuk menggesernya. Seret kartu untuk mengurutkan.</p>
    <div id="sc-grid" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"></div>

    <div class="mt-6 flex flex-wrap items-end gap-3">
      <div>
        <label class="tl-label" for="sc-pdfsize">Halaman PDF</label>
        <select id="sc-pdfsize" class="tl-input" style="width:10rem">
          <option value="a4" selected>A4</option>
          <option value="fit">Sesuai gambar</option>
        </select>
      </div>
      <div>
        <label class="tl-label" for="sc-margin">Margin</label>
        <select id="sc-margin" class="tl-input" style="width:8.5rem">
          <option value="0" selected>Tanpa margin</option>
          <option value="5">5 mm</option>
          <option value="10">10 mm</option>
        </select>
      </div>
      <button type="button" id="sc-pdf" class="tl-btn"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Unduh PDF</button>
      <button type="button" id="sc-zip" class="tl-ghost"><i class="fa-solid fa-file-zipper" aria-hidden="true"></i> Unduh gambar (ZIP)</button>
    </div>
    <div id="sc-dlstatus" class="hidden"></div>
  </div>

  <dialog id="sc-editor" class="tl-dialog tl-editor" aria-label="Atur tepi dokumen">
    <div class="mb-2 flex items-center justify-between gap-3">
      <p class="text-sm font-semibold text-slate-700">Atur tepi dokumen</p>
      <button type="button" id="sc-editor-close" class="tl-icon" aria-label="Tutup editor"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <p class="mb-2 text-xs text-slate-500">Geser keempat titik ke sudut dokumen. Dengan keyboard: fokus pada titik, lalu tekan tombol panah (Shift untuk lompat lebih jauh).</p>
    <div id="sc-stage" class="tl-stage">
      <canvas id="sc-stage-canvas"></canvas>
      <svg id="sc-overlay" aria-hidden="false"><polygon id="sc-poly"></polygon></svg>
      <canvas id="sc-loupe" class="tl-loupe" width="220" height="220" hidden></canvas>
    </div>
    <p id="sc-editor-msg" class="mt-2 min-h-[1.25rem] text-sm text-slate-600" aria-live="polite"></p>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <button type="button" id="sc-ed-auto" class="tl-ghost"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Deteksi otomatis</button>
      <button type="button" id="sc-ed-full" class="tl-ghost">Seluruh gambar</button>
      <span class="flex-1"></span>
      <button type="button" id="sc-ed-cancel" class="tl-ghost">Batal</button>
      <button type="button" id="sc-ed-apply" class="tl-btn">Terapkan</button>
    </div>
  </dialog>

  <dialog id="sc-dialog" class="tl-dialog" aria-label="Pratinjau halaman">
    <div class="mb-2 flex items-center justify-between gap-3">
      <p id="sc-dialog-title" class="text-sm font-semibold text-slate-700"></p>
      <button type="button" id="sc-dialog-close" class="tl-icon" aria-label="Tutup pratinjau"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <img id="sc-dialog-img" alt="Pratinjau halaman hasil scan" />
  </dialog>
</div>

<script>
  import '../scripts/tools/scan-dokumen.ts';
</script>
