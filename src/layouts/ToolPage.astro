---
// src/layouts/ToolPage.astro
// Kerangka halaman satu tool: judul, area tool (slot), cara pakai, catatan, FAQ, tool terkait.
import BaseLayout from './BaseLayout.astro';
import { SITE_URL } from '../consts';
import { categories, toolById, toolPath, type Tool } from '../data/tools';

export interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
const cat = categories[tool.category];
const url = `${SITE_URL}${toolPath(tool)}`;
const related = tool.related.map(toolById);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: SITE_URL + '/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: SITE_URL + '/tools/' },
        { '@type': 'ListItem', position: 3, name: tool.title, item: url },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      name: tool.title,
      description: tool.metaDescription,
      url,
      applicationCategory: tool.kind === 'file' ? 'UtilitiesApplication' : 'EducationalApplication',
      operatingSystem: 'Semua sistem operasi (browser modern)',
      browserRequirements: 'Memerlukan JavaScript',
      inLanguage: 'id',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
      author: { '@id': 'https://rizkyrinaldi.my.id/#person' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: tool.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout title={`${tool.metaTitle} | Rizky Rinaldi`} description={tool.metaDescription} canonical={url}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <section class="bg-white border-b border-slate-100 pt-28 pb-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <nav aria-label="Jejak halaman" class="flex flex-wrap items-center gap-2 text-sm text-slate-400 mb-5">
        <a href="/" class="hover:text-gold-600">Beranda</a>
        <i class="fa-solid fa-chevron-right text-[9px]" aria-hidden="true"></i>
        <a href="/tools/" class="hover:text-gold-600">Tools</a>
        <i class="fa-solid fa-chevron-right text-[9px]" aria-hidden="true"></i>
        <span class="text-slate-600">{tool.title}</span>
      </nav>
      <div class="flex items-start gap-4">
        <div class="hidden sm:flex w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 items-center justify-center flex-shrink-0">
          <i class={`fa-solid ${tool.icon} text-gold-600 text-xl`} aria-hidden="true"></i>
        </div>
        <div>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-gold-700 bg-amber-50 border border-amber-100 px-3 py-1 rounded-full">
            <i class={`fa-solid ${cat.icon} text-[10px]`} aria-hidden="true"></i>{cat.label}
          </span>
          <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-800 leading-tight">{tool.h1}</h1>
          <p class="mt-3 text-slate-500 text-lg leading-relaxed max-w-3xl">{tool.lead}</p>
          <p class="mt-4 inline-flex items-center gap-2 text-sm text-emerald-700 bg-emerald-50 border border-emerald-100 rounded-full px-3 py-1.5">
            <i class="fa-solid fa-lock text-xs" aria-hidden="true"></i>
            {tool.kind === 'file' ? 'Diproses di perangkat Anda. File tidak diunggah ke server.' : 'Semua hitungan dilakukan di browser Anda. Data tidak dikirim ke mana pun.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-12">
    <section aria-label="Alat">
      <div class="tl-card">
        <slot />
      </div>
    </section>

    <section aria-labelledby="cara">
      <h2 id="cara" class="text-xl font-bold text-slate-800 mb-4">Cara memakai</h2>
      <ol class="space-y-3">
        {
          tool.steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 text-gold-700 font-bold flex items-center justify-center text-sm">{i + 1}</span>
              <span class="text-slate-600 leading-relaxed pt-1">{s}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="catatan">
      <h2 id="catatan" class="text-xl font-bold text-slate-800 mb-4">Catatan dan batasan</h2>
      <ul class="space-y-2 bg-amber-50/60 border border-amber-100 rounded-2xl p-5">
        {
          tool.notes.map((n) => (
            <li class="flex gap-3 text-slate-600 leading-relaxed">
              <i class="fa-solid fa-circle-info text-gold-600 mt-1.5 text-sm" aria-hidden="true" />
              <span>{n}</span>
            </li>
          ))
        }
      </ul>
      {
        tool.blog && (
          <p class="mt-4 text-slate-600">
            Pelajari dasar teorinya:{' '}
            {tool.blog.map((b, i) => (
              <>
                {i > 0 && ', '}
                <a href={b.href} class="text-gold-700 font-semibold underline decoration-amber-300 hover:text-gold-600">{b.title}</a>
              </>
            ))}
            .
          </p>
        )
      }
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq" class="text-xl font-bold text-slate-800 mb-4">Pertanyaan yang sering diajukan</h2>
      <div class="space-y-3">
        {
          tool.faq.map((f) => (
            <details class="tl-faq bg-white border border-slate-200 rounded-2xl px-5 py-4">
              <summary class="flex items-center justify-between gap-4 font-semibold text-slate-800">
                {f.q}
                <i class="fa-solid fa-chevron-down text-xs text-slate-400 transition-transform flex-shrink-0" aria-hidden="true" />
              </summary>
              <p class="mt-3 text-slate-600 leading-relaxed">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="terkait">
      <h2 id="terkait" class="text-xl font-bold text-slate-800 mb-4">Tool terkait</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          related.map((r) => (
            <a href={toolPath(r)} class="group bg-white border border-slate-200 rounded-2xl p-4 hover:border-amber-300 hover:shadow-lg hover:shadow-amber-50 transition">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-xl bg-amber-50 text-gold-600 flex items-center justify-center">
                  <i class={`fa-solid ${r.icon} text-sm`} aria-hidden="true" />
                </span>
                <span class="font-semibold text-slate-800 group-hover:text-gold-700">{r.title}</span>
              </div>
              <p class="mt-2 text-sm text-slate-500">{r.short}</p>
            </a>
          ))
        }
      </div>
      <p class="mt-8 text-center text-sm text-slate-500">
        Butuh bantuan skripsi, website, atau publikasi jurnal?
        <a href="/#kontak" class="text-gold-700 font-semibold underline decoration-amber-300 hover:text-gold-600">Hubungi saya</a>
      </p>
    </section>
  </div>
</BaseLayout>
